{
  "expo": {
    "name": "AquaSense",
    "slug": "aquasense-mobile",
    "scheme": "aquasense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF4FB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.aquasense.mobile"
    },
    "android": {
      "package": "br.com.aquasense.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#04274D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O AquaSense usa suas fotos só quando você escolhe uma para anexar a um relato.",
          "cameraPermission": "O AquaSense usa a câmera para você tirar uma foto e anexar a um relato.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AquaSense usa sua localização aproximada para mostrar a previsão de chuva do seu bairro. A localização não é salva nem compartilhada."
        }
      ]
    ]
  }
}
